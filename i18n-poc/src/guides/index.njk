---
permalink: /guides/
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Guides — Vesta</title>
  <meta name="description" content="Practical, research-backed guides on the mental load and the work of running a modern family — from the team building Vesta." />
  <meta name="theme-color" content="#7a3a1d" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Canonical -->
  <link rel="canonical" href="{{ site.url }}/guides/" />

  <!-- Open Graph -->
  <meta property="og:title" content="Guides — Vesta" />
  <meta property="og:description" content="Practical, research-backed guides on the mental load and the work of running a modern family." />
  <meta property="og:url" content="{{ site.url }}/guides/" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GB" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Guides — Vesta" />
  <meta name="twitter:description" content="Practical, research-backed guides on the mental load and the work of running a modern family." />

  <!-- Newsreader, served from Bunny Fonts (EU-hosted, GDPR-clean). Weights 300-700, regular + italic, optical-size axis. -->
  <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.bunny.net/css?family=newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,300;1,6..72,400;1,6..72,500;1,6..72,600&display=swap"
  />

  <!-- Tailwind via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            cream:    '#f4efe6',  // hero paper
            paper2:   '#ede6d8',  // alternating sections
            rule:     '#d8cfbe',  // hairlines
            ink:      '#1f1a14',  // near-black warm — headings + dark section bg
            ink2:     '#3a3127',  // softer body text
            muted:    '#8a8175',  // captions, helper text
            accent:   '#7a3a1d',  // deep terracotta
            'accent-light': '#e6a880'  // lighter terracotta for dark section
          },
          fontFamily: {
            serif: ['Newsreader', 'ui-serif', 'Georgia', 'Cambria', 'Times New Roman', 'serif'],
            sans:  ['Newsreader', 'ui-serif', 'Georgia', 'Cambria', 'Times New Roman', 'serif']
          },
          letterSpacing: {
            'editorial-eyebrow': '0.22em',
            'editorial-mono': '0.18em'
          }
        }
      }
    }
  </script>

  <style>
    html { scroll-behavior: smooth; }
    body {
      font-optical-sizing: auto;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    .opsz-display { font-variation-settings: "opsz" 72; }
    .opsz-md      { font-variation-settings: "opsz" 36; }
    .opsz-sm      { font-variation-settings: "opsz" 18; }
  </style>
</head>

<body class="bg-cream text-ink font-serif antialiased">

  <!-- ============================================== Top bar ============================================== -->
  <header class="sticky top-0 z-40 border-b border-rule bg-cream/85 backdrop-blur">
    <div class="max-w-3xl mx-auto px-6 sm:px-10 py-5 flex items-center justify-between gap-4">
      <a href="/" class="font-serif italic text-2xl text-ink tracking-tight opsz-md">Vesta</a>
      <a href="/" class="text-[11px] font-semibold tracking-editorial-eyebrow uppercase text-ink2 hover:text-accent transition">← Home</a>
    </div>
  </header>

  <main>
    <section class="max-w-3xl mx-auto px-6 sm:px-10 py-16 sm:py-24">

      <p class="text-[11px] sm:text-xs font-semibold tracking-editorial-eyebrow uppercase text-accent mb-7">
        Guides
      </p>

      <h1 class="font-serif opsz-display text-4xl sm:text-5xl md:text-6xl text-ink font-normal leading-[1.05] tracking-tight mb-8" style="text-wrap: pretty;">
        Guides
      </h1>

      <p class="font-serif italic text-lg sm:text-xl text-ink2 leading-relaxed font-light max-w-2xl mb-16 pb-12 border-b border-rule">
        Practical, research-backed writing on the mental load and the work of running a modern family.
      </p>

      <ul class="border-t border-rule">
        {%- for guide in collections.guide | sort(true, false, "data.datePublished") %}
        <li class="border-b border-rule py-8 sm:py-10">
          <h2 class="font-serif text-2xl sm:text-3xl text-ink font-normal leading-snug tracking-tight mb-3">
            <a href="{{ guide.url }}" class="hover:text-accent transition">{{ guide.data.title }}</a>
          </h2>
          <p class="text-sm sm:text-base text-ink2 leading-relaxed font-light max-w-2xl">
            {{ guide.data.description }}
          </p>
          <a href="{{ guide.url }}" class="inline-block mt-4 text-[11px] font-semibold tracking-editorial-eyebrow uppercase text-accent hover:text-ink transition">
            Read →
          </a>
        </li>
        {%- else %}
        <li class="border-b border-rule py-8 text-ink2 font-light">More guides coming soon.</li>
        {%- endfor %}
      </ul>

    </section>
  </main>

</body>
</html>
